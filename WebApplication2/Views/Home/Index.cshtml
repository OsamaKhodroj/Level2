@using WebApplication2.Controllers
@{
    ViewData["Title"] = "Home Page";

    var countries = (IEnumerable<Country>)ViewBag.CountryList;
}


<div id="div1" style="width:200px;height:500px;border:1px solid #ccc;">
</div>

<br />

<input type="button" value="Change Color to Red" onclick="funChangeColor('red')" />
<input type="button" value="Change Color to Blue" onclick="funChangeColor('blue')" />
<input type="button" value="Change Color to Yellow" onclick="funChangeColor('yellow')" />



 
<a asp-controller="Home" asp-action="Index" asp-route-id="10">Go to About Page</a>
<a href="/Home/Index/10">Go to About Page</a>
 


<select class="form-select">
    @foreach (var item in countries)
    {
        <option value="@item.Id">@item.Name</option>
    }
</select>



@section Scripts {
    <script src="~/js/index.js"></script>
}