@using Domains.Dtos.User
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />


@model UserUpdateMode

@if (TempData["UserMessage"] != null)
{
    <div class="alert alert-info" role="alert">
        @TempData["UserMessage"]
    </div>
}


<form asp-controller="Users" asp-action="SaveUserInfo" method="post">
    <input type="hidden" name="Id" id="Id" value="@Model?.UserInfo?.Id" />
    <div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                <label for="FullName" class="form-label">Full Name</label>
                <input type="text" class="form-control" id="FullName" name="FullName" required placeholder="Enter user full name" value="@Model?.UserInfo?.FullName">
            </div>
            <div class="mb-3">
                <label for="EmailAddress" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="EmailAddress" name="EmailAddress" required placeholder="Enter user email address" value="@Model?.UserInfo?.EmailAddress" />
            </div>
            @if (!Model.IsUpdateMode)
            {
                <div class="mb-3">
                    <label for="Password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="Password" name="Password" required placeholder="Enter user password" />
                </div>
            }
        </div>
    </div>
    <input type="submit" class="btn btn-primary" value="Sumit" />
</form>

<br />

<div class="row">
    <div class="col-md-12">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email Address</th>
                    <th scope="col">User Type</th>
                    <th scope="col" class="text-center">#</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Users)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.FullName</td>
                        <td>@item.EmailAddress</td>
                        <td>@item.UserType</td>
                        <td class="text-center">
                            <a asp-controller="Users" asp-action="AddUser" asp-route-id="@item.Id">
                                <span class="material-symbols-outlined edit">
                                    edit_document
                                </span>
                            </a>

                            <span class="material-symbols-outlined delete" onclick="funDeleteUser('@item.Id')">
                                cancel
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div> 